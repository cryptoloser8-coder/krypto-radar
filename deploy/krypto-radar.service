[Unit]
Description=Krypto Radar – skaner tokenów z alertami na Telegram
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=krypto-radar
Group=krypto-radar
Environment=NODE_ENV=production
Environment=HOME=/var/lib/krypto-radar
Environment=RADAR_CONFIG=/var/lib/krypto-radar/config.json
Environment=RADAR_DATA=/var/lib/krypto-radar/data
WorkingDirectory=/opt/krypto-radar
ExecStart=@NODE@ /opt/krypto-radar/server.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=20

# Konfiguracja i dane w /var/lib/krypto-radar, dostępne tylko dla użytkownika usługi.
StateDirectory=krypto-radar
StateDirectoryMode=0700
UMask=0077

# Utwardzenie: usługa nie widzi katalogów domowych, nie może nic zapisać poza swoim katalogiem
# danych, nie dostanie uprawnień roota i nie ruszy zegara, modułów jądra ani urządzeń.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
MemoryMax=600M

[Install]
WantedBy=multi-user.target
